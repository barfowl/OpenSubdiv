#
#   Two shapes -- both 4x2 strips of quads revolved around a pole:
#       - first shares a common normal at the pole
#       - the second intentionally does not (a cone)
#
t interpolateboundary 1/0/0 1

#   Cylinder and cap (common normal):
v  -2.1  -1.0 -1.0
v  -0.1  -1.0 -1.0
v  -0.1   1.0 -1.0
v  -2.1   1.0 -1.0

v  -2.1  -1.0  0.0
v  -0.1  -1.0  0.0
v  -0.1   1.0  0.0
v  -2.1   1.0  0.0

v  -1.1   0.0  0.0
v  -1.1   0.0  0.0
v  -1.1   0.0  0.0
v  -1.1   0.0  0.0

f  1  2  6  5
f  2  3  7  6
f  3  4  8  7
f  4  1  5  8

f 10  9  5  6
f  7 11 10  6
f  7  8 12 11
f 12  8  5  9

#   Cone (no common normal):
v   0.1  -1.0 -1.0
v   2.1  -1.0 -1.0
v   2.1   1.0 -1.0
v   0.1   1.0 -1.0

v   0.1  -1.0 -0.5
v   2.1  -1.0 -0.5
v   2.1   1.0 -0.5
v   0.1   1.0 -0.5

v   1.1   0.0  0.0
v   1.1   0.0  0.0
v   1.1   0.0  0.0
v   1.1   0.0  0.0

f 13 14 18 17
f 14 15 19 18
f 15 16 20 19
f 16 13 17 20

f 17 18 22 21
f 19 23 22 18
f 24 23 19 20
f 24 20 17 21
